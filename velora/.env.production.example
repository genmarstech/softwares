# Production overrides for the containers. Copy to .env.production (never committed).
# docker compose reads .env first, then this file on top of it, so secrets that
# are already in .env (RESEND_API_KEY, bot tokens) do not need repeating.

DEBUG=False
# A long random key of its own, not the development one. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Wrap it in single quotes: Compose would otherwise treat a $ in it as a variable.
SECRET_KEY='change-me'
# 127.0.0.1 and localhost are for the container health check and local curl.
ALLOWED_HOSTS=api.getvelora.co.ke,127.0.0.1,localhost

# The production database (the proddb container). Separate from the dev one in .env.
DB_NAME=velora_prod
DB_USER=velora_prod
DB_PASSWORD='change-me'

FRONTEND_URL=https://getvelora.co.ke
CORS_ALLOWED_ORIGINS=https://getvelora.co.ke,https://www.getvelora.co.ke
CSRF_TRUSTED_ORIGINS=https://getvelora.co.ke,https://www.getvelora.co.ke

# Email. info@genmars.co.ke only sends once genmars.co.ke is verified in Resend.
VELORA_EMAIL_FROM=info@genmars.co.ke
VELORA_PARENT_COMPANY_URL=https://genmars.co.ke

# Bots: fill these in here or in .env, never in chat. See docs/BOTS.md.
# Leave a line commented out rather than empty: an empty value here wipes the one in .env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_DISPLAY_NUMBER=
