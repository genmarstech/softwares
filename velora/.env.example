# Copy to .env and fill in.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=velora_booking_db
DB_USER=velora_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Where customers open their booking links.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email through Resend (https://resend.com). Leave the key empty to only log emails.
# RESEND_FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@getvelora.co.ke

# Set USE_SQLITE=1 to run without Postgres (handy for tests).
# USE_SQLITE=1

# Optional: logo at the top of emails to businesses. Defaults to FRONTEND_URL/brand/email-logo.png.
# VELORA_EMAIL_LOGO_URL=

# Telegram bot (see docs/BOTS.md). Create it with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=VeloraBookingsBot
# Any long random string. Telegram sends it back with every webhook call.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta app "Velora Bookings" > WhatsApp > API setup).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same one into Meta's "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to check webhook signatures.
WHATSAPP_APP_SECRET=
# The number customers message, with country code (for wa.me links).
WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_API_VERSION=v23.0
