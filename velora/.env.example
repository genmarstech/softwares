# Copy to .env and fill in.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=velora_booking_db
DB_USER=velora_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Where customers open their booking links.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email through Resend (https://resend.com). Leave the key empty to only log emails.
# RESEND_FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@getvelora.co.ke

# Set USE_SQLITE=1 to run without Postgres (handy for tests).
# USE_SQLITE=1

# Optional: logo at the top of emails to businesses. Defaults to FRONTEND_URL/brand/email-logo.png.
# VELORA_EMAIL_LOGO_URL=
