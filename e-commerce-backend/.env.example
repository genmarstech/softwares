# Copy to .env and fill in. .env itself is gitignored.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset/false in dev and anywhere Django is directly reachable. Set
# to true only once this deployment's only network path is through a
# trusted TLS-terminating proxy or platform edge (e.g. Railway) — see
# config/settings.py's own comment. Wrong in either direction: unset
# behind a real proxy causes an infinite HTTPS-redirect loop; set with no
# real proxy in front lets anyone spoof it.
DJANGO_TRUST_PROXY_HEADERS=False
# Only needed if /admin/ ever fails with "CSRF verification failed" despite
# ALLOWED_HOSTS being correct — see config/settings.py's own comment.
CSRF_TRUSTED_ORIGINS=

# Postgres
POSTGRES_DB=genmars_ecommerce
POSTGRES_USER=genmars_ecommerce
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker + cache)
# Pick a DB index that doesn't collide with another local project's redis
# (this machine's json-formatter project also uses the default redis on 6379).
REDIS_URL=redis://localhost:6379/5

# CORS — comma-separated origins allowed to call this API. Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (console backend in dev; set these for real SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=store@genmars.co.ke

# M-Pesa Daraja — leave blank to keep payments disabled.
# Production base URL is https://api.safaricom.co.ke; sandbox is
# https://sandbox.safaricom.co.ke. NEVER fire a live STK push without the
# user's explicit go-ahead — see payments/mpesa.py.
MPESA_ENABLED=False
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_CONSUMER_PASSKEY=
MPESA_TILL_NUMBER=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# The URL's own last segment must be MPESA_CALLBACK_SECRET below — Daraja
# signs nothing, so this pre-shared value is what authenticates the callback
# (see payments/views.py::MpesaCallbackView). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving MPESA_CALLBACK_SECRET blank rejects every callback — unconfigured
# must mean closed, never open.
MPESA_CALLBACK_URL=https://api.example.com/api/payments/mpesa/callback/change-me/
MPESA_CALLBACK_SECRET=change-me

# Product image upload limits (catalog/serializers.py). Defaults shown —
# only set these if the defaults are genuinely wrong for this deployment.
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_DIMENSION_PX=4000

# Serves /media/<path> (uploaded product images) through Django itself —
# always on in DEBUG regardless of this flag. Off by default in
# production: fine at pilot/demo scale on a single-container platform
# with no separate static host; not a long-term answer (no caching/
# compression) — see config/urls.py's own comment.
SERVE_MEDIA_VIA_DJANGO=False

# Genmars platform reporting — this backend is a sibling product; a daily
# job (analytics/management/commands/report_commerce_metrics.py) POSTs a
# commerce-metrics snapshot to gen-portal, Genmars' own core backend, so the
# numbers show up in the company's internal ops dashboard. Configurable
# because local dev talks to a gen-portal on localhost, not the real host.
GENMARS_API_ORIGIN=https://api.genmars.co.ke
# A per-system API key, issued from gen-portal's own ops UI (Settings ->
# Engineering -> Systems) AFTER this ships — leave blank until a founder
# issues one. Treat exactly like the M-Pesa secrets above: NEVER commit a
# real value here, never log it. Blank means the daily report fails loudly
# (one log line, non-zero exit, no retry storm) instead of silently doing
# nothing — see analytics/reporting.py.
GENMARS_SYSTEM_KEY=

# Backup encryption (scripts/backup.sh) — a GPG key id/fingerprint/email
# this host already trusts. Leaving this blank produces plain, unencrypted
# dumps with a loud warning; see docs/BACKUP_AND_RECOVERY.md. Required
# before backing up any database with real customer data.
BACKUP_GPG_RECIPIENT=
