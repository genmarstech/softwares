# Copy to .env and fill in. .env itself is gitignored.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=genmars_ecommerce
POSTGRES_USER=genmars_ecommerce
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker + cache)
# Pick a DB index that doesn't collide with another local project's redis
# (this machine's json-formatter project also uses the default redis on 6379).
REDIS_URL=redis://localhost:6379/5

# CORS — comma-separated origins allowed to call this API. Never "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (console backend in dev; set these for real SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=store@genmars.co.ke

# M-Pesa Daraja — leave blank to keep payments disabled.
# Production base URL is https://api.safaricom.co.ke; sandbox is
# https://sandbox.safaricom.co.ke. NEVER fire a live STK push without the
# user's explicit go-ahead — see payments/mpesa.py.
MPESA_ENABLED=False
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_CONSUMER_PASSKEY=
MPESA_TILL_NUMBER=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# The URL's own last segment must be MPESA_CALLBACK_SECRET below — Daraja
# signs nothing, so this pre-shared value is what authenticates the callback
# (see payments/views.py::MpesaCallbackView). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving MPESA_CALLBACK_SECRET blank rejects every callback — unconfigured
# must mean closed, never open.
MPESA_CALLBACK_URL=https://api.example.com/api/payments/mpesa/callback/change-me/
MPESA_CALLBACK_SECRET=change-me

# Product image upload limits (catalog/serializers.py). Defaults shown —
# only set these if the defaults are genuinely wrong for this deployment.
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_DIMENSION_PX=4000

# Backup encryption (scripts/backup.sh) — a GPG key id/fingerprint/email
# this host already trusts. Leaving this blank produces plain, unencrypted
# dumps with a loud warning; see docs/BACKUP_AND_RECOVERY.md. Required
# before backing up any database with real customer data.
BACKUP_GPG_RECIPIENT=
